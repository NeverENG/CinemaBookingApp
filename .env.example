# Docker Compose
COMPOSE_PROJECT_NAME=lterm
APP_PORT=8088
POSTGRES_PORT=5433
BACKEND_IMAGE=lterm-backend:local
FRONTEND_IMAGE=lterm-frontend:local

# PostgreSQL（部署前请修改密码）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=cinema

# Backend
GIN_MODE=release
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRE_HOURS=24

# 演示账号；迁移容器会自动创建并注入 Seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123

# 前端通过容器内 Nginx 同源代理后端
VITE_API_BASE_URL=/api/v1

# 可选 SMTP；留空时不发送真实邮件
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
