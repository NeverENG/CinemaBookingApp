# 数据库（本机 Homebrew PostgreSQL 默认）
DB_HOST=localhost
DB_PORT=5432
DB_USER=4ge0
DB_PASSWORD=
DB_NAME=cinema
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Shanghai

# 或者用完整 DSN 覆盖上面所有配置：
# DB_DSN=host=localhost user=4ge0 dbname=cinema port=5432 sslmode=disable

# 服务
HTTP_ADDR=:8080
GIN_MODE=debug            # debug / release / test
JWT_SECRET=dev-secret     # 生产环境务必替换
JWT_EXPIRE_HOURS=24

# 引导账号（首次迁移时自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123

# 找回密码邮件（QQ SMTP 示例）；不配置时开发模式直接返回验证码
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=your@qq.com
# SMTP_PASSWORD=your-smtp-auth-code
# SMTP_FROM=your@qq.com
