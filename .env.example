# Docker Compose
COMPOSE_PROJECT_NAME=lterm
APP_PORT=8088
POSTGRES_PORT=5433
BACKEND_IMAGE=lterm-backend:local
FRONTEND_IMAGE=lterm-frontend:local

# PostgreSQL（部署前请修改密码）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=cinema

# Backend
GIN_MODE=release
JWT_SECRET=change-this-to-a-long-random-secret
CALLBACK_SECRET=change-this-to-a-separate-callback-secret
JWT_EXPIRE_HOURS=24

# 演示账号；迁移容器会自动创建并注入 Seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
CINEMA_ADMIN_USERNAME=cinema_admin
CINEMA_ADMIN_PASSWORD=cinema123
CINEMA_ADMIN_CINEMA_ID=1
DEMO_USERNAME=demo@lterm.test
DEMO_PASSWORD=demo123

# 前端通过容器内 Nginx 同源代理后端
VITE_API_BASE_URL=/api/v1

# 可选 QQ SMTP；SMTP_USER/SMTP_PASSWORD 留空时页面自动使用开发验证码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=QQ邮箱SMTP授权码
SMTP_FROM=
